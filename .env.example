# Copy this file to .env and replace mock values.
# NEVER commit .env. It is already covered by .gitignore.

# GitHub identity used by the audit agent.
GITHUB_OWNER=example-owner
GITHUB_TOKEN=github_pat_REPLACE_WITH_YOUR_TOKEN

# Optional: repository selection defaults.
SECURITY_AUDIT_SCOPE=all
SECURITY_AUDIT_MAX_PARALLEL=10

# Report output. Keep reports under temp/ because reports are gitignored.
SECURITY_AUDIT_REPORT_ROOT=temp/security-count

# Optional runtime controls.
SECURITY_AUDIT_RUN_TESTS=true
SECURITY_AUDIT_FIX_MODE=pr
SECURITY_AUDIT_PR_MODE=draft

# Optional commit convention.
SECURITY_AUDIT_COMMIT_MESSAGE=fix(security): remediate vulnerabilities
