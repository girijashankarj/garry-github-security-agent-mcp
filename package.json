{
  "name": "garry-github-security-audit",
  "version": "0.1.0",
  "private": false,
  "description": "Community-friendly, agentic GitHub security audit and remediation tool with CLI, MCP, reports, PRs, tests, and audit trails.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "audit": "tsx src/index.ts",
    "mcp": "tsx src/mcp-server.ts",
    "mcp:http": "tsx src/mcp-server.ts --http",
    "build": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@octokit/rest": "^22.0.0",
    "chalk": "^5.6.0",
    "commander": "^14.0.0",
    "inquirer": "^12.9.0",
    "p-limit": "^7.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
